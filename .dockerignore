# Version control
.git
.github

# Internal docs — never ship
PROJECT_SPEC.md
docs-site
docs
.reports

# Dependencies — installed fresh inside the image
node_modules
npm-debug.log*

# Build output — regenerated inside the image
.next
out
dist
build
*.tsbuildinfo
next-env.d.ts

# Env & secrets — runtime config is injected via Compose/env, never baked into the image
.env
.env.*
!.env.example

# Tests / reports — not needed at runtime
tests
playwright-report
test-results
coverage
vitest.config.ts
playwright.config.ts

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
*.log

# Vercel (unrelated deploy target)
.vercel
.vercelignore

Dockerfile
.dockerignore
docker-compose*.yml
