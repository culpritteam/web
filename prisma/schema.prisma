// Prisma schema for "The Culprit". See PROJECT_SPEC.md §7 (internal) for the authoritative model.
// CV-style list content lives in `cv_entry` rows, not in Json columns on `profile` — see
// docs/decisions/ADR-012-cv-entries-and-courses.md. Since ADR-016 those rows, and courses, belong
// to a `team_member`; `profile` is the lab's own singleton.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts, not here.
// PrismaClient is instantiated with a driver adapter (see src/modules/shared/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

// Singleton. The LAB's profile — "The Culprit of Privacy Technologies": its name, tagline, logo,
// overview, department, the Research intro, and the per-tab standfirst copy. Until 2026-09-11 this
// row held the professor's personal identity; that moved onto her `TeamMember` row (the director)
// when the site was re-scoped from a personal site to a lab site (ADR-016). The model keeps the
// name `Profile` so the module and its routes did not have to be renamed with it.
//
// The `*Intro` columns exist because About and Research were the only public tabs with
// admin-editable prose (`bio`, `researchStatement`); Publications, Teaching, Team, Events and
// Make Appointment rendered a heading and then jumped straight into data, with their SEO
// `description` strings hardcoded in the page files. These columns close that gap. They are
// nullable and each page's `generateMetadata` falls back to its existing hardcoded string when
// the column is null, so nothing regresses if the admin never fills them in.
//
// These are nullable SCALAR columns. ADR-012 banned Json LIST columns on `profile` (a repeating
// group in one field); a single text blob per tab is not a repeating group, so it belongs here
// rather than in a new SiteSetting table that would exist to hold six rows.
model Profile {
  id                  String   @id @default(cuid())
  /// The lab's name, rendered as the site header's h1 on every public page.
  labName             String   @map("lab_name")
  labTagline          String?  @map("lab_tagline")
  logoUrl             String?  @map("logo_url")
  /// The About page body.
  labOverview         String?  @map("lab_overview") @db.Text
  /// The lab's department / host institution.
  positionAffiliation String?  @map("position_affiliation") @db.Text
  /// The Research tab's intro prose.
  researchStatement   String?  @map("research_statement") @db.Text
  /// The scheduling link the public Make Appointment tab embeds. Previously readable only from
  /// NEXT_PUBLIC_CALENDLY_URL, which the admin cannot change without a redeploy. Embed-only —
  /// nothing server-side ever calls Calendly (ADR-011).
  calendlyUrl         String?  @map("calendly_url")
  /// Standfirst prose for the public tabs that had none. See the comment block above.
  publicationsIntro   String?  @map("publications_intro") @db.Text
  teamIntro           String?  @map("team_intro") @db.Text
  eventsIntro         String?  @map("events_intro") @db.Text
  appointmentIntro    String?  @map("appointment_intro") @db.Text
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Research {
  id           String                @id @default(cuid())
  title        String
  summary      String                @db.Text
  area         String
  /// Optional external link — a project page, tool listing, or artefact repository.
  link         String?
  /// Who worked on this, in display order. Empty renders no byline — see `ResearchContributor`.
  contributors ResearchContributor[]
  sortOrder    Int                   @default(0) @map("sort_order")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@map("research")
}

model Publication {
  id        String              @id @default(cuid())
  title     String
  /// Credited authors in citation order. This replaced a free-text `authors` column on 2026-09-06
  /// (ADR-015); empty renders no byline — see `PublicationAuthor`.
  authors   PublicationAuthor[]
  venue     String
  year      Int
  /// Nullable: conference and book-chapter entries frequently have no stable public URL.
  link      String?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@map("publication")
}

/// Which team a member belongs to. A flat enum discriminator on `team_member`, NOT a groups table:
/// the `ResearchGroup` entity was deliberately deleted in ADR-016 and is not coming back. The four
/// teams are a fixed editorial grouping of the one Team tab, not user-managed content — an admin
/// never creates a fifth one, so there is nothing for a table to hold.
///
/// The team decides which sections a member's profile page may carry. The rules live in ONE place,
/// src/modules/shared/lib/team-kind.ts, and are enforced by the services on write and again on
/// read (a member whose team changed keeps any now-disallowed rows; they simply stop rendering):
///
///   director/professor  bio, all 7 CV sections, courses, projects, research+publications, links
///   research            bio, research_interest only,  no courses, projects, research+publications, links
///   development         bio, no CV sections,          no courses, projects, no research/publications, links
enum TeamKind {
  director
  professor
  research
  development
}

/// A member of the lab. Every member is listed on the public Team tab and has a profile page at
/// `/team/[id]`, which renders this row plus its `CvEntry`, `Course`, `Project` and `MemberLink`
/// rows — whichever of them the member's `teamKind` allows.
///
/// The director — the professor who runs the lab — is a member like everyone else, flagged
/// `isDirector`. Her bio, CV, links and photo lived on `Profile` until 2026-09-11 (ADR-016).
///
/// At most one row has `isDirector = true`. Postgres can express that only as a partial unique
/// index (`team_member_one_director ... WHERE is_director`), and Prisma cannot express a partial
/// index at all, so it lives in migration 20260911120000_lab_team_profiles and is documented here —
/// `prisma migrate dev` will report it as drift. The repository also clears the flag on every other
/// row in the same transaction that sets it, so the admin never hits the constraint.
model TeamMember {
  id                  String             @id @default(cuid())
  name                String
  /// How this person is credited on a paper — "J. Jaimunk", not "Jenjira Jaimunk, PhD.". Bylines
  /// are plain text (ADR-016); a byline name that matches `name` or this value, case-insensitively,
  /// is highlighted and links to this member's profile. No rule reliably derives one form from the
  /// other, so it is stored.
  citationName        String?            @map("citation_name")
  role                String // e.g. "PhD Candidate", "Visiting Professor"
  affiliation         String?
  bio                 String?            @db.Text
  photoUrl            String?            @map("photo_url")
  /// Which team this member belongs to, and therefore which profile sections they may have.
  /// No DB-level default on purpose: the team is an editorial decision the admin makes on every
  /// create, so a silent fallback would only hide a bug. `isDirector` is kept consistent with it by
  /// the service (`resolveTeamAssignment`) — the flag is true exactly when the team is `director`.
  teamKind            TeamKind           @map("team_kind")
  /// The lab director. Sorts first on the Team tab whatever `sortOrder` says. See the model comment
  /// for the one-director invariant. Redundant with `teamKind = director` by design: it is what the
  /// partial unique index constrains, and what every "director first" ordering reads.
  isDirector          Boolean            @default(false) @map("is_director")
  sortOrder           Int                @default(0) @map("sort_order")
  /// Soft links from events this member was added to. The event rows snapshot their own copy of
  /// the name/role, so deleting this member nulls the link without erasing event history.
  eventParticipations EventParticipant[]
  /// This member's CV lines, taught courses, projects and external links. Cascade: they are part of
  /// the member's profile and mean nothing without it.
  cvEntries           CvEntry[]
  courses             Course[]
  projects            Project[]
  links               MemberLink[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@map("team_member")
}

/// Something a member built or is building, rendered on their profile page. Allowed for every team
/// — it is the only content section a `development` member has besides their bio and links.
///
/// Its own table rather than a `CvEntry` section: a project carries a summary paragraph and an
/// optional link, and is ordered per member, which no CV line is.
model Project {
  id           String     @id @default(cuid())
  teamMemberId String     @map("team_member_id")
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  title        String
  summary      String     @db.Text
  /// Optional external link — a repository, demo or write-up.
  link         String?
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([teamMemberId, sortOrder])
  @@map("project")
}

/// An external profile link on a member's page. Replaced the fixed `linkedin_url` and
/// `google_scholar_url` columns: two columns could only ever express two services, and every member
/// wanted a different third one (GitHub, ORCID, a personal site).
///
/// `label` is free text the admin types — deliberately not an enum, so adding a service is data,
/// not a migration. `url` is validated as http(s) at the boundary like every other stored URL.
///
/// Edited as part of the member, the same way `PublicationAuthor` rows are edited as part of their
/// publication: the member payload carries the whole list and the repository replaces it in one
/// transaction. There is no per-link API.
model MemberLink {
  id           String     @id @default(cuid())
  teamMemberId String     @map("team_member_id")
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  /// e.g. "LinkedIn", "Google Scholar", "GitHub", "ORCID".
  label        String
  url          String
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([teamMemberId, sortOrder])
  @@map("member_link")
}

// --- Teaching & CV -------------------------------------------------------------------------------
// Two tables back the CV and Teaching sections of a member's profile page. Both belong to one
// `TeamMember` (ADR-016); before that they were the professor's alone and hung off nothing.
//
// `cv_entry` replaced seven Json columns on `profile` on 2026-09-02 (ADR-012). Those columns were
// a 1NF violation — a repeating group in a single field — and, more practically, they could only
// ever be written by a whole-document profile PUT, which made it impossible to split them across
// two pages or edit one entry without rewriting all seven lists.
//
// It is ONE table with a `section` discriminator rather than seven tables, because all seven
// sections carry an identical attribute set: this is one entity with a category, not seven
// entities. Every section renders the same way; only the heading and the page differ.

enum CvSection {
  education
  fellowship
  scholarship
  research_interest
  invited_talk
  teaching_role
  teaching_award
}

model CvEntry {
  id           String     @id @default(cuid())
  teamMemberId String     @map("team_member_id")
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  /// Decides which heading this entry renders under on the member's profile.
  section      CvSection
  title        String
  subtitle     String?
  /// Free text, not an Int: entries are routinely a range ("2019-2023") or "present".
  year         String?

  description String?  @db.Text
  /// Ordering is per member and section, so `sortOrder` is only meaningful within one of those.
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([teamMemberId, section, sortOrder])
  @@map("cv_entry")
}

/// A taught course. A real entity rather than a `CvEntry` section — it carries a code, a term and
/// a level that no CV line has.
model Course {
  id           String     @id @default(cuid())
  teamMemberId String     @map("team_member_id")
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  /// Course code as the institution prints it, e.g. "CS 4235". Optional — seminars often have none.
  code         String?
  title        String
  /// Grouping key on the public tab, e.g. "Undergraduate" / "Graduate". Free text, matching the
  /// `Research.area` precedent — level naming differs per institution.
  level        String
  /// When it was or is taught, e.g. "Fall 2025".
  term         String?
  description  String?    @db.Text
  /// Optional syllabus or course-page link.
  link         String?
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([teamMemberId, sortOrder])
  @@map("course")
}

// --- Events -------------------------------------------------------------------------------------
// Replaced the admin-declared Appointment table on 2026-09-01. An event is plain published
// content: the admin writes it, every visitor sees it. There is no status, no lifecycle and no
// per-row visibility flag — `eventDate` alone decides whether the public tab files it under
// Upcoming or Past, evaluated at render time.
//
// Media are native Postgres text arrays, not Json: they are flat lists of URLs with no internal
// structure, and an array column keeps them queryable and typed instead of opaque.

model Event {
  id           String             @id @default(cuid())
  title        String
  description  String             @db.Text
  /// Long-form write-up, shown only inside the event's detail dialog. `description` stays the
  /// short summary the event card itself renders, which is what lets every card keep the same
  /// height no matter how much has been written here.
  content      String?            @db.Text
  eventDate    DateTime           @map("event_date")
  /// Public R2 URLs, uploaded through POST /api/admin/events/photo.
  photoUrls    String[]           @map("photo_urls")
  /// YouTube watch/share URLs (or bare 11-character video IDs). Embed-only — no video file is
  /// ever stored or proxied by this app; see modules/integrations/youtube.
  videoUrls    String[]           @map("video_urls")
  participants EventParticipant[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([eventDate])
  @@map("event")
}

/// Who took part in an event — the site's own team members and outside guests in one list.
///
/// Every row carries its own `name`/`role`/`photoUrl`, copied from the team member at the moment
/// it was added rather than read through the relation. An event is a historical record: changing
/// someone's job title or deleting a member must not silently rewrite what last year's event says.
/// `teamMemberId` is kept as a soft link (nulled if that member is deleted) purely so the same
/// person cannot be added twice.
model EventParticipant {
  id      String @id @default(cuid())
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Null for an outside guest, and nulled if the linked member is later deleted.
  teamMemberId String?     @map("team_member_id")
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  /// Snapshot taken when the participant was added. This is what renders.
  name     String
  role     String?
  photoUrl String? @map("photo_url")

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One row per member per event. Postgres treats NULLs as distinct, so this constrains linked
  /// members without limiting how many guests an event can have.
  @@unique([eventId, teamMemberId])
  @@index([eventId])
  @@map("event_participant")
}

// --- Attribution ---------------------------------------------------------------------------------
// Who a publication or a research item is credited to, as an ordered list of plain typed names.
// Rows rather than one text column so the order is explicit and each name is its own value; an
// empty list renders no byline.
//
// There is no link to `team_member` (dropped 2026-09-11, ADR-016). A byline is a fixed historical
// fact, and the public site decides at render time whether a name is a lab member: a name matching a
// member's `name` or `citationName` (case-insensitive, trimmed) is highlighted and links to that
// member's profile; any other name renders grey. Renaming or deleting a member never rewrites a
// byline.

/// Who a publication is credited to, in citation order. Replaced a single free-text `authors`
/// column on 2026-09-06 (ADR-015); the team-member link and the professor's own-row flag it gained
/// then were removed in ADR-016.
model PublicationAuthor {
  id            String      @id @default(cuid())
  publicationId String      @map("publication_id")
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  /// The name exactly as it appears on the paper.
  name String

  /// Author position. Unlike every other `sortOrder` in this schema this is not a display
  /// preference — first author and last author carry meaning in a citation, so the order the admin
  /// arranged is part of the record.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([publicationId])
  @@map("publication_author")
}

/// Who worked on a research item. Same shape and same reasoning as `PublicationAuthor` — read its
/// comment. The one difference: `sortOrder` here is display order only, with no citation meaning.
model ResearchContributor {
  id         String   @id @default(cuid())
  researchId String   @map("research_id")
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)

  /// The name exactly as the admin typed it.
  name String

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([researchId])
  @@map("research_contributor")
}

// --- Better Auth (single admin) ---------------------------------------------------------------
// Owned by Better Auth's Prisma adapter (DB-backed cookie sessions, NOT JWT). Do not query these
// from domain code — only the auth module hands the Prisma client to the adapter.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
